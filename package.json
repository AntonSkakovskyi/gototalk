{
  "name": "gototalk",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "pnpm -r --if-present --parallel dev",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:migrate": "pnpm -r --if-present db:migrate",
    "db:pull": "pnpm -r --if-present db:pull",
    "db:seed": "pnpm -r --if-present db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
