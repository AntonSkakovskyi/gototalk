# Скопіюй у .env і заповни значення. .env у git не потрапляє.

# PostgreSQL (podman compose)
POSTGRES_USER=gototalk
POSTGRES_PASSWORD=
POSTGRES_DB=gototalk

# Рядки підключення: postgres://<користувач>:<пароль>@localhost:5432/<база>; користувач, пароль і база мають збігатися з POSTGRES_*
DATABASE_URL=
# Той самий сервер, але база gototalk_test (створюється init-скриптом)
TEST_DATABASE_URL=

# API
PORT=3000
LOG_LEVEL=info

# Адаптери портів: fake | deepgram (STT), fake | gemini (LLM)
STT_PROVIDER=fake
LLM_PROVIDER=fake
# Режим помилки Fake-адаптерів (порожньо = вимкнено)
FAKE_STT_FAIL=
FAKE_LLM_FAIL=

# Лише для локальної розробки: зберігати аудіо в теку поза репозиторієм
DEV_KEEP_AUDIO=false
DEV_AUDIO_DIR=

JWT_ACCESS_SECRET=
